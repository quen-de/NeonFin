#!/usr/bin/env python3
"""Reject commit messages with AI attribution trailers or instance-specific terms.

Terms come from "neutrality_terms" in harness/config.local.json (gitignored), or
from the file NEONFIN_LOCAL_CONFIG points at.
"""

import json
import os
import pathlib
import re
import subprocess
import sys

CO_AUTHOR = re.compile(r"^co-authored-by:\s*(?P<name>[^<\n]*?)\s*(?:<(?P<email>[^>\n]*)>)?\s*$", re.I | re.M)
# Judged on the whole name or the address, so people who share a first name with an
# assistant (Claude, Devin) can still be credited.
ASSISTANT_NAME = re.compile(
    r"^(claude( (code|opus|sonnet|haiku|fable)\b.*)?|copilot|chatgpt|codex|gemini( code assist)?|cursor( agent)?"
    r"|aider\b.*|windsurf|codeium|devin( ai)?)$",
    re.I,
)
ASSISTANT_DOMAIN = re.compile(r"@(.*\.)?(anthropic\.com|openai\.com|cursor\.com|aider\.chat|codeium\.com|windsurf\.com|devin\.ai|cognition\.ai)$", re.I)
BOT_ADDRESS = re.compile(r"\[bot\]@|^gemini-code-assist@", re.I)
SESSION = re.compile(r"^claude-session:|claude\.ai/code/session_", re.I | re.M)


def assistant_trailer(body: str) -> bool:
    for m in CO_AUTHOR.finditer(body):
        email = m["email"] or ""
        if ASSISTANT_NAME.match(m["name"]) or ASSISTANT_DOMAIN.search(email) or BOT_ADDRESS.search(email):
            return True
    return bool(SESSION.search(body))


def local_config() -> pathlib.Path:
    if os.environ.get("NEONFIN_LOCAL_CONFIG"):
        return pathlib.Path(os.environ["NEONFIN_LOCAL_CONFIG"])
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
    return pathlib.Path(top) / "harness" / "config.local.json"


def problems(message: str, terms: list[str]) -> list[str]:
    body = "\n".join(line for line in message.splitlines() if not line.startswith("#"))
    found = []
    if assistant_trailer(body):
        found.append("AI attribution trailer")
    low = body.lower()
    found += [f"instance term {t!r}" for t in terms if t.lower() in low]
    return found


def main(argv: list[str]) -> int:
    message = pathlib.Path(argv[1]).read_text(encoding="utf-8")
    cfg = local_config()
    if not cfg.exists():
        print(f"commit-msg: no local config at {cfg}; instance terms are not checked", file=sys.stderr)
    terms = json.loads(cfg.read_text()).get("neutrality_terms", []) if cfg.exists() else []
    found = problems(message, terms)
    for p in found:
        print(f"commit-msg: {p}", file=sys.stderr)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
