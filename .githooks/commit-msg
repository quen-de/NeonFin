#!/usr/bin/env python3
"""Reject commit messages with AI attribution trailers or instance-specific terms.

Terms come from "neutrality_terms" in harness/config.local.json (gitignored), or
from the file NEONFIN_LOCAL_CONFIG points at.
"""

import json
import os
import pathlib
import re
import subprocess
import sys

AI_TRAILER = re.compile(r"^(co-authored-by:.*(claude|anthropic|openai|copilot|chatgpt|codex|gemini|cursor|aider|windsurf|codeium|devin)|claude-session:)", re.I | re.M)
SESSION_URL = re.compile(r"claude\.ai/code/session_", re.I)


def local_config() -> pathlib.Path:
    if os.environ.get("NEONFIN_LOCAL_CONFIG"):
        return pathlib.Path(os.environ["NEONFIN_LOCAL_CONFIG"])
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
    return pathlib.Path(top) / "harness" / "config.local.json"


def problems(message: str, terms: list[str]) -> list[str]:
    body = "\n".join(line for line in message.splitlines() if not line.startswith("#"))
    found = []
    if AI_TRAILER.search(body) or SESSION_URL.search(body):
        found.append("AI attribution trailer")
    low = body.lower()
    found += [f"instance term {t!r}" for t in terms if t.lower() in low]
    return found


def main(argv: list[str]) -> int:
    message = pathlib.Path(argv[1]).read_text(encoding="utf-8")
    cfg = local_config()
    if not cfg.exists():
        print(f"commit-msg: no local config at {cfg}; instance terms are not checked", file=sys.stderr)
    terms = json.loads(cfg.read_text()).get("neutrality_terms", []) if cfg.exists() else []
    found = problems(message, terms)
    for p in found:
        print(f"commit-msg: {p}", file=sys.stderr)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
